<Application x:Class="POS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:POS.Desktop.Converters"
             xmlns:local="clr-namespace:POS.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <converters:StringToGeometryConverter x:Key="StringToGeometry" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
