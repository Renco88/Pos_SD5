<UserControl x:Class="POS.Desktop.Views.DiscountManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Discount Campaigns &amp; Promo Rules" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Right" />
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Discounts}" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Campaign Name" Binding="{Binding Name}" Width="250" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" FontWeight="Bold" />
                        <DataGridTextColumn Header="Min Order ৳" Binding="{Binding MinPurchaseAmount, StringFormat='৳{0:F2}'}" Width="140" />
                        <DataGridTextColumn Header="Promo Code" Binding="{Binding PromoCode}" Width="140" />
                        <DataGridTextColumn Header="Status" Binding="{Binding IsActive}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
