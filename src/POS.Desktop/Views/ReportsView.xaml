<UserControl x:Class="POS.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <!-- Header Row -->
            <Grid Margin="0,0,0,16">
                <TextBlock Text="Financial &amp; Executive Reports" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                <Button Content="Refresh Reports" Command="{Binding RefreshCommand}" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Profit & Loss Summary Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Profit &amp; Loss Statement (Trailing 30 Days)" FontWeight="Bold" FontSize="{StaticResource FontSizeSubheader}" Margin="0,0,0,16"/>

                    <Grid Margin="0,4">
                        <TextBlock Text="Gross Revenue (Sales):" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ProfitLoss.TotalRevenue, StringFormat='৳{0:F2}'}" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Cost of Goods Sold (COGS):" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ProfitLoss.CostOfGoodsSold, StringFormat='-৳{0:F2}'}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Gross Profit:" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ProfitLoss.GrossProfit, StringFormat='৳{0:F2}'}" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Operating Expenses:" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ProfitLoss.TotalExpenses, StringFormat='-৳{0:F2}'}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Customer Refunds / Returns:" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ProfitLoss.TotalRefunds, StringFormat='-৳{0:F2}'}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,10"/>
                    <Grid>
                        <TextBlock Text="NET PROFIT:" FontWeight="Bold" FontSize="{StaticResource FontSizeSubheader}" />
                        <TextBlock Text="{Binding ProfitLoss.NetProfit, StringFormat='৳{0:F2}'}" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
