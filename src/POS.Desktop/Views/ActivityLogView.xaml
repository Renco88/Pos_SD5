<UserControl x:Class="POS.Desktop.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="System Audit Logs &amp; Activity Tracking" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Right" />
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="140" />
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="120" />
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
